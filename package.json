{
  "name": "mattpocock-skills-zh-cn-pi",
  "version": "1.2.3",
  "private": true,
  "description": "面向 Pi 打包的 Matt Pocock Engineering 与 Productivity Skills 简体中文版",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/legdonkey/mattpocock-skills-zh-CN.git"
  },
  "scripts": {
    "check": "npm run check:translation && npm run check:pi && npm run check:fork && git diff --check && git diff --cached --check",
    "check:translation": "node ./scripts/check-translation.mjs",
    "check:pi": "node ./scripts/check-pi-package.mjs",
    "check:fork": "node ./scripts/check-fork.mjs",
    "check:claude": "claude plugin validate . --strict",
    "upstream:check": "node ./scripts/upstream-check.mjs",
    "upstream:sync": "node ./scripts/upstream-sync.mjs"
  },
  "keywords": [
    "pi-package",
    "agent-skills",
    "engineering",
    "tdd",
    "code-review"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/skill-profiles.ts",
      "./extensions/claude-compat.ts"
    ],
    "skills": []
  }
}
